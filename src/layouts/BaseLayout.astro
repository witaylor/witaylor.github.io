---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  bodyClass?: string;
}

const { title, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="preload" as="image" href="/res/will-bike.webp" />
    <link rel="preload" as="image" href="/res/will-taylor.JPG" />
  </head>
  <body class={bodyClass}>
    <slot />
    <Analytics />
  </body>
</html>
