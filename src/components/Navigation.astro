---
interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;
---

<div class="flex flex-col md:flex-row items-center justify-between">
  <div class="flex items-center w-full gap-2">
    <span>/</span>
    <a href="/" title="Go back home">Will Taylor</a>
    <span>/</span>
    <a href="#" title="Stay where you are">{currentPage}</a>
  </div>

  <div class="hidden md:block">
    <a
      href="/res/WillTaylorCV.pdf"
      download
      class="plausible-event-name=Download+CV+(Desktop) transition duration-300 shadow-sm hover:shadow-lg rounded-xl px-4 py-2 bg-button-light hover:bg-button-light-hover text-ink no-underline flex items-center gap-2 hover:scale-105"
    >
      <div>
        <img src="/res/download-icon.png" class="w-14 aspect-square" />
      </div>
      <span>Download</span>
    </a>
  </div>
</div>
